DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# DashScope / Alibaba Bailian settings. Set LLM_PROVIDER=dashscope or
# GENERATOR_PROVIDER=dashscope to use these as defaults.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen2.5-7b-instruct-1m

# Generic LLM settings. If set, these take precedence over DEEPSEEK_*.
LLM_PROVIDER=openai_compatible
LLM_API_STYLE=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Llama-3.1-8B
LLM_DISABLE_AUTH=false

# Optional runtime overrides
BENCHMARK_LOG_LEVEL=INFO

# Vector retrieval / embedding settings
ZHIPUAI_API_KEY=59f02cee05af7c568ce9437208f9973a.7IWhNBnCBeV5IzV5
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
VECTOR_DB_BACKEND=qdrant
RETRIEVAL_MODE=lexical
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=benchmark_sections
QDRANT_PATH=artifacts/qdrant
QDRANT_USE_LOCAL=true
RERANK_BACKEND=tei
TEI_RERANK_URL=http://127.0.0.1:8080
TEI_RERANK_TIMEOUT=30
TEI_RERANK_API_KEY=
TEI_RERANK_MAX_RETRIES=1
RERANK_TOP_N=5
RERANK_ALLOW_MOCK_FALLBACK=false
RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
USE_RERANK=true
RERANKER_DEVICE=cpu
RERANKER_USE_FP16=false
RERANKER_QUERY_MAX_LENGTH=256
RERANKER_PASSAGE_MAX_LENGTH=512

# Runtime generator settings for experiment pipelines
GENERATOR_BACKEND=mock
GENERATOR_PROVIDER=openai_compatible
GENERATOR_API_KEY=
GENERATOR_BASE_URL=https://api.openai.com/v1
GENERATOR_MODEL=
GENERATOR_TIMEOUT=60
GENERATOR_MAX_TOKENS=512
GENERATOR_TEMPERATURE=0
GENERATOR_JSON_MODE=true
