{
  "input_dir": "data",
  "artifacts_dir": "artifacts",
  "outputs_dir": "outputs",
  "logs_dir": "logs",
  "log_level": "INFO",
  "max_files": null,
  "concurrency": 4,
  "request_timeout": 120,
  "retry_attempts": 3,
  "retry_backoff_min": 1,
  "retry_backoff_max": 20,
  "resume": true,
  "dry_run": false,
  "llm": {
    "temperature": 0.1,
    "max_tokens": 2048,
    "json_mode": true
  },
  "qa_generation": {
    "max_per_section": 4,
    "type_quota": {
      "fact": 1,
      "relation": 1,
      "multi_evidence": 1,
      "explanation": 1
    },
    "allow_cross_section": false,
    "allow_cross_document": false,
    "require_strong_constraints": true,
    "require_evidence": true,
    "explanation_min_length": 40,
    "similarity_threshold": 0.9
  },
  "validation": {
    "support_score_threshold": 0.8,
    "completeness_score_threshold": 0.75
  },
  "embedding": {
    "provider": "zhipuai",
    "api_key": null,
    "model": "embedding-3",
    "dimension": 1024,
    "batch_size": 32
  },
  "retrieval": {
    "backend": "qdrant",
    "mode": "lexical",
    "top_k": 5,
    "candidate_multiplier": 3,
    "vector_db_backend": "qdrant",
    "qdrant_url": "http://127.0.0.1:6333",
    "qdrant_collection": "benchmark_sections",
    "qdrant_path": "artifacts/qdrant",
    "qdrant_use_local": false
  },
  "rerank": {
    "enabled": true,
    "use_rerank": true,
    "backend": "tei",
    "model_path": "/home/paper/Benchmark/models/bge-reranker-v2-m3",
    "device": "cpu",
    "use_fp16": false,
    "query_max_length": 256,
    "passage_max_length": 512,
    "tei_url": "http://127.0.0.1:8080",
    "timeout": 30,
    "api_key": null,
    "max_retries": 1,
    "top_n": 5,
    "allow_mock_fallback": false
  },
  "generator": {
    "backend": "mock",
    "api_key": null,
    "base_url": "https://api.openai.com/v1",
    "model": "",
    "timeout": 60,
    "max_tokens": 512,
    "temperature": 0.0,
    "json_mode": true
  }

}
